
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      Role     @default(PATRON)
  createdAt DateTime @default(now())

  reviews   Review[]
}

model Genre {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  books       Book[]
}

model Book {
  id            String   @id @default(cuid())
  title         String
  author        String
  isbn          String?  @unique
  publishedYear Int?
  genreId       String
  genre         Genre    @relation(fields: [genreId], references: [id])
  createdAt     DateTime @default(now())

  reviews       Review[]
}

model Review {
  id        String   @id @default(cuid())
  bookId    String
  userId    String
  rating    Int
  comment   String?
  book      Book     @relation(fields: [bookId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
